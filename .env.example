# Copy to .env and fill in the values. Never commit .env (see .gitignore).

# OpenAI API key – server side only, never sent to the mobile client (ADR-0005).
OPENAI_API_KEY=

# PostgreSQL connection: postgresql+<driver>://<user>:<password>@<host>:<port>/<db>
# Driver (asyncpg or psycopg) is decided by the T1.12 spike (ADR-0003).
DATABASE_URL=

# Model names per feature – never hard-coded (ADR-0005).
AI_MODEL_CONVERSATION=
AI_MODEL_FEEDBACK=
AI_MODEL_EXTRACTION=
